{
  "manifest_version": 2,
  "name": "Orange Translate",
  "version": "1.1.0",
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "description": "Install a local PDF translator and attach bilingual and Chinese results beside the original PDF in Zotero.",
  "applications": {
    "zotero": {
      "id": "orange-translate-dev@local.invalid",
      "update_url": "https://local.invalid/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*"
    }
  }
}
